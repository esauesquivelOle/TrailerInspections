<?xml version="1.0" encoding="UTF-8"?>
<!-- Uploaded files are served only through api.php; block direct requests on IIS -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="inspections" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
